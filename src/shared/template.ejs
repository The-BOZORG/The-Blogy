<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify your account</title>
</head>

<body style="margin: 0; padding: 0; background: #f5f5f5; font-family: Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="padding: 40px 20px;">
    <tr>
      <td align="center">
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
          style="max-width: 480px; background: #ffffff; border-radius: 12px; padding: 40px;">
          <tr>
            <td align="center">

              <h2 style="margin: 0 0 32px; font-size: 22px;">
                BLOGY
              </h2>

              <h1 style="margin: 0 0 16px; font-size: 24px;">
                Verify your account
              </h1>

              <p style="margin: 0 0 24px; color: #666666; font-size: 15px;">
                Use the verification code below to continue.
              </p>

              <div style="
                  display: inline-block;
                  padding: 14px 24px;
                  background: #f5f5f5;
                  border-radius: 8px;
                  font-size: 28px;
                  font-weight: bold;
                  letter-spacing: 6px;
                ">
                <%= code %>
              </div>

              <p style="margin: 24px 0 0; color: #888888; font-size: 13px;">
                This code expires in 5 minutes.
              </p>

              <p style="margin: 24px 0 0; color: #aaaaaa; font-size: 12px;">
                If you didn't request this code, you can safely ignore this email.
              </p>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>