generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  username String
  email String @unique
  password String? 
  googleId  String?  @unique
  role Role @default(USER)
  status AccountStatus  @default(PENDING)
  isActive Activity @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
  AUTHOR
}

enum Activity {
  ACTIVE
  BANNED
  MUTE
}

enum AccountStatus  {
  PENDING
  VERIFIED
}