generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String        @id @default(uuid())
  username  String
  email     String        @unique
  password  String
  role      Role          @default(USER)
  status    AccountStatus @default(PENDING)
  isActive  Activity      @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  blogs     Blog[]  @relation("UserBlogs")
  comments     Comment[]  @relation("UserComments")
  authorRequests  AuthorRequest[]  @relation("UserRequests")
}

enum Role {
  ADMIN
  USER
  AUTHOR
}

enum Activity {
  ACTIVE
  BANNED
  MUTE
}

enum AccountStatus {
  PENDING
  VERIFIED
}


model Blog {
  id        String        @id @default(uuid())
  title  String
  content String
  slug     String        @unique
  authorId  String 
  status   BlogStatus   @default(DRAFT)
  banner  String?      
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation("UserBlogs",fields: [authorId],references: [id],onDelete: Cascade)

  comments     Comment[]  @relation("BlogComments")
}



enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Comment{
  id        String        @id @default(uuid())
  content   String
  userId      String  
  blogId     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation("UserComments",fields: [userId],references: [id],onDelete: Cascade)

  blog  Blog  @relation("BlogComments",fields: [blogId],references: [id], onDelete: Cascade)
}


model AuthorRequest{
  id        String        @id @default(uuid())
  userId      String  
  reason    String?
  status     RequestStatus   @default(PENDING)   
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation("UserRequests",fields: [userId],references: [id],onDelete: Cascade)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}